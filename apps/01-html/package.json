{
  "name": "@dreamboard/html",
  "private": true,
  "version": "1.1.0",
  "description": "DreamBoard HTML edition — HTML5 + Tailwind CSS v4 + Alpine.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "css": "tailwindcss -i src/css/main.css -o dist/assets/css/main.css",
    "css:watch": "tailwindcss -i src/css/main.css -o dist/assets/css/main.css --watch",
    "audit": "node scripts/audit.js"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.14.9",
    "@dreamboard/tailwind-config": "*",
    "alpinejs": "^3.14.9",
    "apexcharts": "^7.4.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "^4.1.11",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.1.11"
  }
}
