{
  "$schema": "https://design-tokens.org/schema.json",
  "description": "DreamBoard design tokens — generated from packages/tailwind-config/theme.css",
  "color": {
    "primary": {
      "50": {
        "$type": "color",
        "$value": "#eff2ff"
      },
      "100": {
        "$type": "color",
        "$value": "#e0e6ff"
      },
      "200": {
        "$type": "color",
        "$value": "#c6d0ff"
      },
      "300": {
        "$type": "color",
        "$value": "#a3b2ff"
      },
      "400": {
        "$type": "color",
        "$value": "#7c8eff"
      },
      "500": {
        "$type": "color",
        "$value": "#465fff"
      },
      "600": {
        "$type": "color",
        "$value": "#3644f5"
      },
      "700": {
        "$type": "color",
        "$value": "#2a34d9"
      },
      "800": {
        "$type": "color",
        "$value": "#262eae"
      },
      "900": {
        "$type": "color",
        "$value": "#252b89"
      },
      "950": {
        "$type": "color",
        "$value": "#171a4d"
      },
      "DEFAULT": {
        "$type": "color",
        "$value": "{color.primary.600}"
      },
      "foreground": {
        "$type": "color",
        "$value": "#ffffff"
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "\"Inter Variable\", Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"Segoe UI Mono\", Menlo, Consolas, monospace"
    }
  },
  "shadow": {
    "soft": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgb(15 23 42 / 0.04), 0 4px 12px -2px rgb(15 23 42 / 0.06), 0 12px 32px -8px rgb(15 23 42 / 0.08)"
    },
    "card": {
      "$type": "shadow",
      "$value": "0 1px 2px 0 rgb(15 23 42 / 0.05), 0 2px 8px -2px rgb(15 23 42 / 0.05)"
    }
  },
  "motion": {
    "page": {
      "enter": {
        "$type": "transition",
        "$value": {
          "animation": "page-enter",
          "duration": "0.18s",
          "timingFunction": "cubic-bezier(0.22, 1, 0.36, 1)"
        }
      }
    },
    "row": {
      "enter": {
        "$type": "transition",
        "$value": {
          "animation": "row-enter",
          "duration": "0.28s",
          "timingFunction": "cubic-bezier(0.22, 1, 0.36, 1)"
        }
      }
    }
  },
  "accent": {
    "blue": {
      "color": {
        "primary": {
          "50": {
            "$type": "color",
            "$value": "#eff6ff"
          },
